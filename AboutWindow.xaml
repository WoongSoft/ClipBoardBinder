<Window x:Class="ID648.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About.WindowTitle}"
        Width="520"
        Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="#3B82F6" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#60A5FA" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Padding="18"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ControlForegroundBrush}"
                       Text="{DynamicResource App.Title}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,12">
                <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{DynamicResource About.VersionLabel}" />
                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource ControlForegroundBrush}" x:Name="VersionText" />
            </StackPanel>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ControlForegroundBrush}"
                               Text="WoongSoft" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="© WoongSoft" />

                    <Border Height="1"
                            Margin="0,16,0,16"
                            Background="{DynamicResource ControlBorderBrush}" />

                    <TextBlock Foreground="{DynamicResource ControlForegroundBrush}"
                               FontWeight="SemiBold"
                               Text="{DynamicResource About.SupportTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource ControlForegroundBrush}"
                               Text="{DynamicResource About.SupportBody}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               Foreground="{DynamicResource ControlForegroundBrush}">
                        <Hyperlink Click="SupportLink_Click">https://paypal.me/woongsoft</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button MinWidth="110" Padding="18,8" Click="CloseButton_Click" IsDefault="True" Content="{DynamicResource Button.OK}" Style="{StaticResource ProminentActionButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
