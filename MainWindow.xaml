<Window x:Class="ID648.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ID648"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Topmost="{Binding IsAlwaysOnTop}"
        Title="{DynamicResource App.Title}"
        Height="300"
        Width="700"
        MinHeight="230"
        MinWidth="360"
        ResizeMode="CanResize"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
        <Grid Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TitleBarForegroundBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeButton_Click"
                                Content="&#xE921;" />
                        <Button x:Name="MaximizeRestoreButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeRestoreButton_Click"
                                Content="&#xE922;" />
                        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseButton_Click"
                                Content="&#xE8BB;" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource MenuBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4">
                <DockPanel LastChildFill="True">
                    <Menu DockPanel.Dock="Right"
                          Background="Transparent"
                          VerticalAlignment="Top">
                        <MenuItem Header="{DynamicResource Menu.Settings}">
                            <!-- Group: basic toggles -->
                            <MenuItem Header="{DynamicResource Menu.AlwaysOnTop}"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                                      StaysOpenOnClick="True" />
                            <MenuItem Header="{DynamicResource Menu.DisplayFileNamesInClipboard}"
                                      IsCheckable="True"
                                      IsChecked="{Binding DisplayFileNamesInClipboard, Mode=TwoWay}"
                                      StaysOpenOnClick="True" />
                            <MenuItem Header="{DynamicResource Menu.ShowFileNamesOnly}"
                                      IsCheckable="True"
                                      IsChecked="{Binding DisplaySourceFileNamesOnly, Mode=TwoWay}"
                                      StaysOpenOnClick="True" />
                            <MenuItem Header="{DynamicResource Menu.ShowNotifications}"
                                      IsCheckable="True"
                                      IsChecked="{Binding ShowNotifications, Mode=TwoWay}"
                                      StaysOpenOnClick="True" />
                            <Separator />
                            <!-- Group: Theme -->
                            <MenuItem Header="{DynamicResource Menu.Theme}">
                                <MenuItem Header="{DynamicResource Menu.Theme.Dark}"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsDarkModeSelected, Mode=OneWay}"
                                          Command="{Binding ChangeThemeCommand}"
                                          CommandParameter="{x:Static local:AppTheme.Dark}"
                                          StaysOpenOnClick="True" />
                                <MenuItem Header="{DynamicResource Menu.Theme.Light}"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsLightModeSelected, Mode=OneWay}"
                                          Command="{Binding ChangeThemeCommand}"
                                          CommandParameter="{x:Static local:AppTheme.Light}"
                                          StaysOpenOnClick="True" />
                            </MenuItem>
                            <Separator />
                            <!-- Group: Language -->
                            <MenuItem Header="{DynamicResource Menu.Language}">
                                <MenuItem x:Name="SystemLanguageMenuItem"
                                          Header="{DynamicResource Language.System}"
                                          Click="LanguageMenuItem_Click"
                                          IsCheckable="True"
                                          StaysOpenOnClick="True"
                                          Tag="system" />
                                <MenuItem x:Name="EnglishLanguageMenuItem"
                                          Header="{DynamicResource Language.English}"
                                          Click="LanguageMenuItem_Click"
                                          IsCheckable="True"
                                          StaysOpenOnClick="True"
                                          Tag="en" />
                                <MenuItem x:Name="KoreanLanguageMenuItem"
                                          Header="{DynamicResource Language.Korean}"
                                          Click="LanguageMenuItem_Click"
                                          IsCheckable="True"
                                          StaysOpenOnClick="True"
                                          Tag="ko" />
                                <MenuItem x:Name="JapaneseLanguageMenuItem"
                                          Header="{DynamicResource Language.Japanese}"
                                          Click="LanguageMenuItem_Click"
                                          IsCheckable="True"
                                          StaysOpenOnClick="True"
                                          Tag="ja" />
                                <MenuItem x:Name="SpanishLanguageMenuItem"
                                          Header="{DynamicResource Language.Spanish}"
                                          Click="LanguageMenuItem_Click"
                                          IsCheckable="True"
                                          StaysOpenOnClick="True"
                                          Tag="es" />
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="{DynamicResource Menu.Help}">
                            <MenuItem Header="{DynamicResource Menu.Help}" Click="HelpMenuItem_Click" />
                            <MenuItem Header="{DynamicResource Menu.Homepage}" Click="HomepageMenuItem_Click" />
                            <MenuItem Header="{DynamicResource Menu.PrivacyPolicy}" Click="PrivacyPolicyMenuItem_Click" />
                            <MenuItem Header="{DynamicResource Menu.ThirdPartyNotices}" Click="ThirdPartyNoticesMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Menu.About}" Click="AboutMenuItem_Click" />
                        </MenuItem>
                    </Menu>

                    <WrapPanel VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               ItemHeight="34">
                        <CheckBox Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{DynamicResource Check.EnableClipboardCopy}"
                                  IsChecked="{Binding IsClipboardCopyEnabled, Mode=TwoWay}" />
                        <Button Style="{StaticResource ProminentActionButtonStyle}"
                                Margin="12,0,0,0"
                                Padding="16,8"
                                VerticalAlignment="Center"
                                Click="RemoveSelectedClipboardItemsButton_Click"
                                Content="{DynamicResource Button.RemoveSelected}" />
                        <Button Style="{StaticResource ProminentActionButtonStyle}"
                                Margin="12,0,0,0"
                                Padding="16,8"
                                VerticalAlignment="Center"
                                Command="{Binding ClearFileClipboardCommand}"
                                Content="{DynamicResource Button.ClearFileClipboard}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ControlForegroundBrush}"
                                   Text="{DynamicResource Header.FilesPrepared}" />
                        <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding PreparedFilesSummary}" />
                    </StackPanel>

                    <ListBox x:Name="TrackedFilesListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding FilePaths}"
                             SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
